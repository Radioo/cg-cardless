{
  "name": "cg-cardless",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --forceExit",
    "generate-icons": "node scripts/generate-icons.js",
    "test:e2e": "npx expo export --platform web && npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:ios:build": "npx detox build --configuration ios.sim.release",
    "test:e2e:ios": "npx detox test --configuration ios.sim.release",
    "test:e2e:ios:ci": "npx detox test --configuration ios.sim.release --cleanup --headless"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/alert-dialog": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "expo": "~58.0.19",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-css-interop": "^0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "~3.4.19",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "detox": "^20.51.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-dev-client": "~58.0.15",
    "globals": "^17.13.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "sharp": "^0.35.5",
    "test-renderer": "~1.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
